# LOG_DIR can be used to tell the Service where to look for game logs
# This option can be used in development and at runtime
LOG_DIR=path/to/logs

# FORCE_MOCK_DATA=true will force the service to use mock data from resources/mock-game-data/
# This is useful for UI development without Elite Dangerous running
# Set to true to use mock data, comment out or set to false to use real game logs
# FORCE_MOCK_DATA=true

# Feature Flags - Control optional features in ICARUS Terminal
# Flags support both camelCase and SCREAMING_SNAKE_CASE formats:
#   - camelCase: icarusInaraTokenCurrencyEnabled
#   - SCREAMING_SNAKE_CASE: ICARUS_INARA_TOKEN_CURRENCY_ENABLED
# Both formats resolve to the same flag. Use whichever you prefer.

# Show feature flags panel in Settings (defaults to false)
# ICARUS_SHOW_FEATURE_FLAGS=true

# Enable INARA token currency ledger and data exchange (defaults to false)
# ICARUS_INARA_TOKEN_CURRENCY_ENABLED=true

# Enable token jackpot bonus for debt recovery (defaults to false)
# ICARUS_INARA_TOKEN_JACKPOT_ENABLED=true

# Enable legacy token recovery compatibility mode (defaults to true)
# ICARUS_INARA_TOKEN_RECOVERY_COMPAT_ENABLED=true

# Enable INARA settings panel in Settings (defaults to false)
# ICARUS_ENABLE_INARA_SETTINGS=true

# SIGN_BUILD is used as a flag to indicate if release should be digitally signed
# This is used only for production builds. You will need your own certificate if
# you wish to publish signed releases.
SIGN_CERT_NAME="Open Source Developer, Iain Collins"
SIGN_TIME_SERVER="http://time.certum.pl"